// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. O Freelancer (Único dono e utilizador do sistema)
model User {
  id            String      @id @default(uuid())
  name          String
  email         String      @unique
  password      String
  cpf           String      @unique
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  operations    Operation[]

  @@map("users")
}

// 2. Operações
model Operation {
  id            String    @id @default(uuid())
  name          String
  
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  projects      Project[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("operations")
}

// 3. Projetos / Lançamentos (Ex: "Lançamento Curso Digital Abril", "Campanha Dia das Mães")
model Project {
  id            String      @id @default(uuid())
  name          String
  
  // Controle de recebimento da comissão total deste projeto
  isPaid        Boolean     @default(false)
  paidAt        DateTime?
  
  operationId   String
  operation     Operation   @relation(fields: [operationId], references: [id], onDelete: Cascade)

  // Porcentagem da comissão do freelancer em cima dos criativos (ex: 10.5 para 10.5%)
  freelancerCutPercentage Decimal @db.Decimal(5, 2) @default(0)

  // Define se o projeto está ativo para aparecer no Dashboard principal
  isActive      Boolean     @default(true)
  
  creatives     Creative[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("projects")
}

// 4. Criativos / Anúncios
model Creative {
  id               String   @id @default(uuid())
  name             String   // Ex: "Vídeo Vendas 01", "Carrossel Y"
  
  // Lucro total que este criativo gerou para a operação
  totalProfit      Decimal  @db.Decimal(10, 2) 
  
  // O valor exato da SUA comissão em cima deste criativo
  freelancerCut    Decimal  @db.Decimal(10, 2)

  // Controle de recebimento da comissão específica deste criativo
  isPaid           Boolean  @default(false)
  paidAt           DateTime?
  
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("creatives")
}