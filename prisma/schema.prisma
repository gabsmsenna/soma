// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. O Freelancer (Único dono e utilizador do sistema)
model User {
  id         String      @id @default(uuid())
  name       String
  email      String      @unique
  password   String
  cpf        String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  operations Operation[]

  @@map("users")
}

// 2. Operações (campanhas de cliente)
model Operation {
  id        String    @id @default(uuid())
  name      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("operations")
}

// 3. Projetos (dentro de uma operação)
model Project {
  id                      String     @id @default(uuid())
  name                    String
  freelancerCutPercentage Decimal    @db.Decimal(5, 2) @default(0)
  isActive                Boolean    @default(true)
  isPaid                  Boolean    @default(false)
  paidAt                  DateTime?
  operationId             String
  operation               Operation  @relation(fields: [operationId], references: [id], onDelete: Cascade)
  creatives               Creative[]
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@map("projects")
}

// 4. Criativos / Anúncios (dentro de um projeto)
model Creative {
  id            String    @id @default(uuid())
  name          String
  totalProfit   Decimal   @db.Decimal(10, 2)
  freelancerCut Decimal   @db.Decimal(10, 2)
  isPaid        Boolean   @default(false)
  paidAt        DateTime?
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("creatives")
}
