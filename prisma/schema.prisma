// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. O Freelancer (Único dono e utilizador do sistema)
model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  password        String
  cpf             String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  operations      Operation[]
  monthlyGoals    MonthlyGoal[]

  @@map("users")
}

// 2. Operações (campanhas de cliente)
model Operation {
  id                      String     @id @default(uuid())
  name                    String
  freelancerCutPercentage Decimal    @db.Decimal(5, 2) @default(0)
  active                  Boolean    @default(true)
  userId                  String
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatives               Creative[]
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @updatedAt

  @@map("operations")
}

// 3. Criativos / Anúncios (dentro de uma operação)
model Creative {
  id              String          @id @default(uuid())
  name            String
  totalProfit     Decimal         @db.Decimal(10, 2)
  freelancerCut   Decimal         @db.Decimal(10, 2)
  isActive        Boolean         @default(true)
  isPaid          Boolean         @default(false)
  paidAt          DateTime?
  operationId     String
  operation       Operation       @relation(fields: [operationId], references: [id], onDelete: Cascade)
  profitEntries   ProfitEntry[]
  profitLogs      ProfitLog[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("creatives")
}

// 5. Registros de pagamento (quando o freelancer clica "Marcar Pago")
model ProfitEntry {
  id          String   @id @default(cuid())
  totalProfit Float
  commission  Float
  creativeId  String
  creative    Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  paidAt      DateTime @default(now())

  @@map("profit_entries")
}

// 6. Histórico de entradas de lucro por criativo
model ProfitLog {
  id             String   @id @default(uuid())
  amount         Decimal  @db.Decimal(10, 2)
  previousAmount Decimal  @db.Decimal(10, 2)
  creativeId     String
  creative       Creative @relation(fields: [creativeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@map("profit_logs")
}

// 4. Meta mensal de lucro do freelancer
model MonthlyGoal {
  id        String   @id @default(uuid())
  amount    Decimal  @db.Decimal(10, 2)
  month     Int
  year      Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@map("monthly_goals")
}
